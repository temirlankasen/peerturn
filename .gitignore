# Hidden local configuration and state; public metadata is explicit.
.*
!/.gitignore
!/.dockerignore
!/.editorconfig
!/.gitattributes
!/.golangci.yml
!/.goreleaser.yaml
!/.github/
!/.claude-plugin/

# Private research inputs, historical reports, and collection tooling.
/research/sources/
/research/data/
/research/docs/
/research/reports/
/research/scripts/

